---
import { services } from '../lib/content';

const drawings = [
  'M24 156h152M40 156V70h120v86M66 70V42h68v28M58 104h22v24H58zM112 104h22v24h-22zM84 156v-30h32v30M52 86h96',
  'M22 140h156M48 140c22-36 36 8 58-20 18-24 34-6 62-28M64 92v16M96 84v16M128 76v16M40 150h120',
  'M30 36h140v120H30zM30 76h140M30 116h140M76 36v120M122 36v120',
  'M36 44h128M36 76h128M36 108h128M36 140h128M68 44v96M100 44v96M132 44v96',
  'M28 48h144v28H28zM28 76h144v28H28zM28 104h144v28H28zM70 48v28M110 76v28M86 104v28',
  'M46 48h108M58 48v78M142 48v78M40 126h120M62 36h76',
  'M32 32h136v116H32zM32 90h136M100 32v116',
];
const marks = services.map((service, index) => ({
  name: service.title,
  draw: drawings[index] || drawings[2],
}));
---

<ul class="trade">
  {
    marks.map((mark) => (
      <li>
        <svg viewBox="0 0 200 180" aria-hidden="true">
          <rect width="200" height="180" fill="#1a1a1a" />
          <path d="M16 16h168M16 46h168M16 76h168M16 106h168M16 136h168M16 164h168M46 16v148M76 16v148M106 16v148M136 16v148M166 16v148" fill="none" stroke="#c9d0d8" stroke-width="0.6" opacity="0.35" />
          <path d={mark.draw} fill="none" stroke="#fff" stroke-width="2.4" />
          <path d={mark.draw} fill="none" stroke="#1a46c8" stroke-width="1.15" transform="translate(3 3)" opacity="0.9" />
          <path d="M18 168h18M18 168v-8M164 168h18M182 168v-8" fill="none" stroke="#1a46c8" stroke-width="1.4" />
        </svg>
        <strong>{mark.name}</strong>
      </li>
    ))
  }
</ul>
