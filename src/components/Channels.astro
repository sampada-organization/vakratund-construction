---
import Icon from './Icon.astro';
import { links, site } from '../lib/content';
---

<div class="reach-slot">
  <div class="reach reach-icons">
    <a class="btn-wa" href={links.whatsapp} aria-label="WhatsApp" title="WhatsApp"><Icon name="chat" /></a>
    <a class="btn-gmail" href={links.email} aria-label="Gmail" title="Gmail"><Icon name="mail" /></a>
    <a class="btn-call" href={links.tel} aria-label={`Call ${site.phoneDisplay}`} title={`Call ${site.phoneDisplay}`}><Icon name="phone" /></a>
  </div>
</div>
