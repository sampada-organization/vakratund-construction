---
import Icon from './Icon.astro';
import { links, pages, site, url } from '../lib/content';
---

<footer class="site-footer">
  <div class="wrap foot">
    <div>
      <h2>{site.name}</h2>
      <p>
        {site.legalForm}. Proprietor {site.proprietor}.<br />
        {site.office.lines.join(', ')}
      </p>
      <p class="foot-links">
        <a href={links.maps}><Icon name="pin" />Map</a>
        <a class="btn-call" href={links.tel}><Icon name="phone" />{site.phoneDisplay}</a>
        <a class="btn-wa" href={links.whatsapp}><Icon name="chat" />WhatsApp</a>
        <a class="btn-gmail" href={links.email}><Icon name="mail" />Gmail</a>
        <a href={links.proprietorEmail}>{site.proprietorEmail}</a>
      </p>
      
    </div>
    <div>
      <h2>On this site</h2>
      <ul>
        {pages.map((page) => <li><a href={url(page.href)}>{page.label}</a></li>)}
        <li><a href={url('/meet')}><Icon name="calendar" />Book a visit</a></li>
        <li><a href={url('/legal/privacy')}><Icon name="shield" />Privacy</a></li>
        
      </ul>
    </div>
    <div>
      <h2>Hours</h2>
      <p>{site.hours}.</p>
      <p>Call, WhatsApp, or email. One person answers.</p>
    </div>
  </div>
</footer>
