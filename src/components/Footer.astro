---
import Icon from './Icon.astro';
import { links, site, url } from '../lib/content';
---

<footer class="site-footer">
  <div class="wrap foot">
    <div>
      <h2>{site.name}</h2>
      <p>
        {site.legalForm}. Proprietor {site.proprietor}.<br />
        {site.office.lines.join(', ')}
      </p>
      <p class="foot-links">
        <a href={links.maps}><Icon name="pin" />Map</a>
        <a href={links.tel}><Icon name="phone" />{site.phoneDisplay}</a>
        <a href={links.email}><Icon name="mail" />{site.email}</a>
        <a href={links.proprietorEmail}><Icon name="person" />{site.proprietorEmail}</a>
      </p>
      <p class="note">
        The company profile also records an earlier office at {site.profileOffice}. The address above is the
        September 2026 office note.
      </p>
    </div>
    <div>
      <h2>On this site</h2>
      <ul>
        <li><a href={url('/projects')}><Icon name="building" />Work</a></li>
        <li><a href={url('/plant')}><Icon name="gear" />Plant and tools</a></li>
        <li><a href={url('/process')}><Icon name="tripod" />Process</a></li>
        <li><a href={url('/clients')}><Icon name="people" />Clients</a></li>
        <li><a href={url('/onboard')}><Icon name="person" />Client identity</a></li>
        <li><a href={url('/identity')}><Icon name="frame" />Digital identity</a></li>
        <li><a href={url('/meet')}><Icon name="calendar" />Book a visit</a></li>
        <li><a href={url('/resources')}><Icon name="sheet" />Resources</a></li>
        <li><a href={url('/legal/privacy')}><Icon name="shield" />Privacy</a></li>
        <li><a href={url('/admin')}><Icon name="desk" />Desk</a></li>
      </ul>
    </div>
    <div>
      <h2>Photographs</h2>
      <p>The company profile says the work pictures were executed in 2021. They are compressed copies of those frames.</p>
      <p>{site.hours}.</p>
    </div>
  </div>
</footer>
