---
import { home, url } from '../lib/content';

interface Props {
  kicker: string;
  title: string;
  tagline: string;
  lead: string;
  measure: string;
}

const { kicker, title, tagline, lead, measure } = Astro.props;
const frames = home.heroSlides || [];
---

<section class="hero-film" data-stage tabindex="0" aria-roledescription="carousel" aria-label="Vakratund Construction">
  {
    frames.map((frame, index) => (
      <img
        src={url(frame.src)}
        width={frame.width}
        height={frame.height}
        alt=""
        class={index === 0 ? 'is-on' : ''}
        loading="eager"
        fetchpriority={index === 0 ? 'high' : 'low'}
        decoding="async"
        data-slide={index}
      />
    ))
  }
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-layout">
  <div class="hero-copy">
    <p class="kicker">{kicker}</p>
    <h1>{title}</h1>
    <p class="tagline">{tagline}</p>
    <p class="lede">{lead}</p>
    <p class="measure">{measure}</p>
  </div>
  <div class="hero-caption">
    {
      frames.map((frame, index) => (
        <article class={index === 0 ? 'is-on' : ''} aria-hidden={index === 0 ? undefined : 'true'}>
          <h2>{frame.title}</h2>
          <p>{frame.line}</p>
        </article>
      ))
    }
  </div>
  </div>
  <p class="visually-hidden" data-live aria-live="polite"></p>
  <div class="hero-meter" aria-hidden="true"><span data-meter></span></div>
</section>

<script>
  const HOLD = 7600;
  document.querySelectorAll<HTMLElement>('[data-stage]').forEach((root) => {
    const shots = [...root.querySelectorAll<HTMLImageElement>(':scope > img[data-slide]')];
    const lines = [...root.querySelectorAll<HTMLElement>('.hero-caption article')];
    const meter = root.querySelector<HTMLElement>('[data-meter]');
    const live = root.querySelector<HTMLElement>('[data-live]');
    if (shots.length === 0) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer = 0;
    let startX = 0;
    let ticket = 0;
    const runMeter = () => {
      if (!meter) return;
      meter.classList.remove('is-run');
      void meter.offsetWidth;
      if (reduced) return;
      meter.classList.add('is-run');
    };
    const paint = (incoming: number, previous: number) => {
      index = incoming;
      shots.forEach((shot, i) => {
        shot.classList.toggle('is-on', i === incoming);
        shot.classList.toggle('is-under', i === previous && previous !== incoming);
      });
      lines.forEach((line, i) => {
        const on = i === incoming;
        line.classList.toggle('is-on', on);
        line.toggleAttribute('aria-hidden', !on);
      });
      const current = lines[incoming];
      if (live && current) live.textContent = current.textContent?.replace(/\s+/g, ' ').trim() || '';
      runMeter();
    };
    const show = (next: number) => {
      const previous = index;
      const incoming = (next + shots.length) % shots.length;
      const mark = ++ticket;
      const shot = shots[incoming];
      const apply = () => {
        if (mark !== ticket) return;
        paint(incoming, previous);
      };
      if (!shot || shot.complete) apply();
      else shot.decode().then(apply).catch(apply);
    };
    const stop = () => window.clearInterval(timer);
    const start = () => {
      stop();
      if (reduced || shots.length < 2) return;
      timer = window.setInterval(() => show(index + 1), HOLD);
    };
    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') show(index + 1);
      if (event.key === 'ArrowLeft') show(index - 1);
    });
    root.addEventListener('pointerdown', (event) => {
      startX = event.clientX;
    });
    root.addEventListener('pointerup', (event) => {
      const distance = event.clientX - startX;
      if (Math.abs(distance) < 56) return;
      show(index + (distance < 0 ? 1 : -1));
    });
    root.addEventListener('pointerenter', stop);
    root.addEventListener('pointerleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    show(0);
    start();
  });
</script>
