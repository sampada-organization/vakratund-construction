---
import { plants, url } from '../lib/content';
---

<section class="section stats-band">
  <div class="wrap">
    <header class="row-head">
      <h2>Tools</h2>
      <a href={url('/plant')} aria-label="Further: Plant and tools">Further</a>
    </header>
    <ul class="stats">
      {
        plants.register.map((item) => (
          <li>
            <strong>{item.count}</strong>
            <span>{item.name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
