---
import { projects, url } from '../lib/content';

interface Props {
  minimal?: boolean;
}

const { minimal = false } = Astro.props;
const tags = [
  ...new Set(
    projects.flatMap((project) =>
      String(project.tags || '')
        .split(',')
        .map((tag) => tag.trim())
        .filter(Boolean),
    ),
  ),
];
---

{
  !minimal && (
    <div class="filters" data-filters>
      <div>
        <button type="button" data-value="" aria-pressed="true">All</button>
        {tags.map((tag) => (
          <button type="button" data-value={tag} aria-pressed="false">
            {tag.charAt(0).toUpperCase() + tag.slice(1)}
          </button>
        ))}
      </div>
    </div>
  )
}
<ul class="work-grid">
  {
    projects.map((project) => (
      <li data-tags={project.tags}>
        <a href={url(`/projects/${project.slug}`)}>
          <img
            src={url(project.image)}
            width={project.width}
            height={project.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
          <span>
            <small>{String(project.tags || '').split(',')[0]}</small>
            {project.title}
          </span>
        </a>
      </li>
    ))
  }
</ul>

<script>
  document.querySelectorAll<HTMLElement>('[data-filters]').forEach((bar) => {
    const grid = bar.nextElementSibling;
    if (!grid) return;
    const cards = [...grid.querySelectorAll<HTMLElement>('li')];
    bar.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
      button.addEventListener('click', () => {
        const chosen = button.dataset.value || '';
        bar.querySelectorAll('button').forEach((peer) => {
          peer.setAttribute('aria-pressed', String(peer === button));
        });
        cards.forEach((card) => {
          const tags = (card.dataset.tags || '').split(',').map((tag) => tag.trim());
          card.hidden = Boolean(chosen) && !tags.includes(chosen);
        });
      });
    });
  });
</script>
