---
import { plants, projects, url } from '../lib/content';

const frames = [
  ...projects.flatMap((project) =>
    project.gallery.map((frame) => ({
      src: frame.src,
      width: frame.width,
      height: frame.height,
      title: project.title,
      href: `/projects/${project.slug}`,
    })),
  ),
  ...plants.register
    .filter((item) => item.image)
    .map((item) => ({
      src: item.image,
      width: item.width,
      height: item.height,
      title: item.name,
      href: '/plant',
    })),
];
---

<div class="reel" data-reel>
  <div class="reel-view">
    <ul class="reel-track">
      {
        frames.map((frame, index) => (
          <li>
            <button type="button" data-full={index} aria-label={`View full: ${frame.title}`}>
              <img
                src={url(frame.src)}
                width={frame.width}
                height={frame.height}
                alt=""
                loading={index < 3 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : undefined}
                decoding="async"
              />
              <span>{frame.title}</span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="reel-controls">
    <button type="button" data-prev aria-label="Previous pictures">Previous</button>
    <button type="button" data-next aria-label="Next pictures">Next</button>
    <button type="button" data-open aria-label="View full">View full</button>
  </div>
  <dialog class="lightbox">
    <img alt="" />
    <div class="lightbox-bar">
      <button type="button" class="lightbox-close" aria-label="Close">Close</button>
      <button type="button" class="lightbox-prev" aria-label="Previous picture">Previous</button>
      <button type="button" class="lightbox-next" aria-label="Next picture">Next</button>
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.reel-track');
    const items = [...root.querySelectorAll<HTMLButtonElement>('[data-full]')];
    const dialog = root.querySelector('dialog');
    const view = dialog?.querySelector('img');
    if (!track || items.length === 0 || !dialog || !view) return;
    const sources = items.map((button) => button.querySelector('img')?.getAttribute('src') || '');
    let slide = 0;
    let cursor = 0;
    let timer = 0;
    let startX = 0;
    let moved = false;
    const per = () => (window.matchMedia('(min-width: 1100px)').matches ? 3 : window.matchMedia('(min-width: 720px)').matches ? 2 : 1);
    const max = () => Math.max(0, items.length - per());
    const go = (next: number) => {
      const limit = max();
      slide = next > limit ? 0 : next < 0 ? limit : next;
      track.style.transform = `translateX(-${(slide * 100) / per()}%)`;
    };
    const stop = () => window.clearInterval(timer);
    const start = () => {
      stop();
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      timer = window.setInterval(() => go(slide + 1), 4200);
    };
    const open = (at: number) => {
      stop();
      cursor = (at + sources.length) % sources.length;
      view.src = sources[cursor];
      view.alt = items[cursor].getAttribute('aria-label') || '';
      if (!dialog.open) dialog.showModal();
    };
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(slide - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(slide + 1));
    root.querySelector('[data-open]')?.addEventListener('click', () => open(slide));
    items.forEach((button) =>
      button.addEventListener('click', () => {
        if (moved) {
          moved = false;
          return;
        }
        open(Number(button.dataset.full || 0));
      }),
    );
    dialog.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lightbox-prev')?.addEventListener('click', () => open(cursor - 1));
    dialog.querySelector('.lightbox-next')?.addEventListener('click', () => open(cursor + 1));
    dialog.addEventListener('close', () => start());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    const viewBox = root.querySelector('.reel-view');
    viewBox?.addEventListener('pointerdown', (event) => {
      startX = event.clientX;
      moved = false;
    });
    viewBox?.addEventListener('pointerup', (event) => {
      const delta = event.clientX - startX;
      if (Math.abs(delta) > 48) {
        moved = true;
        go(slide + (delta < 0 ? 1 : -1));
      }
    });
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', () => {
      if (!dialog.open) start();
    });
    window.addEventListener('resize', () => go(slide));
    start();
  });
</script>
