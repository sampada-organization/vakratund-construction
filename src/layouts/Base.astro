---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, url } from '../lib/content';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, jsonLd } = Astro.props;
const full = title === site.name ? `${site.name} · Chakan` : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(url('/brand/mark.jpg'), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#12151c" />
    <link rel="icon" href={url('/brand/mark.jpg')} type="image/jpeg" />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <script>
      import { bindForms } from '../scripts/forms';
      bindForms();
    </script>
  </body>
</html>
