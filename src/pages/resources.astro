---
import Base from '../layouts/Base.astro';
import Continue from '../components/Continue.astro';
import Icon from '../components/Icon.astro';
import { resources, url } from '../lib/content';
import { resourceIcon } from '../lib/marks';

const description = 'Company profile and roads poster from Vakratund Construction, Chakan.';
---

<Base title="Resources" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Resources</h1>
      <p class="intro">Two files. The company profile. The roads poster.</p>
      <div class="resource-list">
        {
          resources.map((item) => (
            <article>
              <p class="kicker" style="color: var(--blue)"><Icon name={resourceIcon(item.kind)} />{item.kind}</p>
              <h2><a href={url(item.href)}>{item.title}</a></h2>
              <p>{item.note}</p>
            </article>
          ))
        }
      </div>
      <Continue href="/profile" label="Profile" text="The same facts, written out." />
    </div>
  </section>
</Base>
