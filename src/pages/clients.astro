---
import Base from '../layouts/Base.astro';
import ClientStrip from '../components/ClientStrip.astro';
import Continue from '../components/Continue.astro';
import { url } from '../lib/content';

const description = 'Industrial clients of Vakratund Construction in Chakan.';
---

<Base title="Clients" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Clients</h1>
      <p class="intro">
        Five names from the company profile. Each has a plant in Chakan. The profile lists Stanley Black &amp; Decker as one client.
      </p>
      <ClientStrip />
      <p><a href={url('/onboard')}>Bring a new client on board</a></p>
      <Continue href="/profile" label="Profile" text="The proprietor, the offices, and the years." />
    </div>
  </section>
</Base>
