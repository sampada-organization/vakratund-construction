---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { clients, url } from '../lib/content';

const description = 'Industrial clients of Vakratund Construction in Chakan.';
---

<Base title="Clients" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Clients</h1>
      <p class="intro">Industrial clients in Chakan. A new enquiry does not add a name here. It reaches the office first.</p>
      <ul class="client-list">
        {
          clients.map((client) => (
            <li>
              <Icon name="pin" />
              <h2>{client.name}</h2>
              <small>{client.place}</small>
            </li>
          ))
        }
      </ul>
      <p><a href={url('/onboard')}>Bring a new client on board</a></p>
    </div>
  </section>
</Base>
