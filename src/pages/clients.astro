---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { clients, url } from '../lib/content';

const description = 'Clients named in the Vakratund Construction company profile, all in Chakan.';
---

<Base title="Clients" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Clients</h1>
      <p class="intro">
        The company profile lists these names under “Our esteemed clients”. The previous website showed marks for several
        of the same firms. This page sets the names in type and does not redraw their logos. A new client is not added
        here by the public form — that form files a lead. A name joins this list only when the office edits the desk and
        rebuilds.
      </p>
      <ul class="client-list">
        {
          clients.map((client) => (
            <li>
              <Icon name="pin" />
              <h2>{client.name}</h2>
              <small>{client.place}</small>
            </li>
          ))
        }
      </ul>
      <p><a href={url('/onboard')}>Bring a new client on board</a></p>
    </div>
  </section>
</Base>
