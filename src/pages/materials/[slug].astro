---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { linesOf, materialBySlug, materials, projects, url } from '../../lib/content';
import { materialIcon } from '../../lib/marks';

export function getStaticPaths() {
  return materials.map((item) => ({ params: { slug: item.slug } }));
}

const { slug } = Astro.params;
const item = materialBySlug(slug || '');
if (!item) throw new Error('Missing material');

const photos = linesOf(item.images);
const named = String(item.projects || '')
  .split(',')
  .map((part) => part.trim())
  .filter(Boolean);
const related = named.length
  ? projects.filter((project) => named.includes(project.slug))
  : projects.filter((project) =>
      String(project.tags || '')
        .split(',')
        .map((tag) => tag.trim())
        .includes(item.category),
    );
const description = `${item.title}. ${item.summary}`;
---

<Base title={item.title} description={description}>
  <article class="section">
    <div class="wrap material-detail">
      <p class="kicker">
        <Icon name={materialIcon(item.category)} />
        {item.category}
      </p>
      <h1>{item.title}</h1>
      <p class="intro">{item.summary}</p>
      {
        item.image.startsWith('/media/work/') && (
          <p>The company profile dates photographs of this kind of work to jobs executed in 2021.</p>
        )
      }
      <figure class="plate-photo">
        <img
          src={url(item.image)}
          width={item.width}
          height={item.height}
          alt={item.title}
          fetchpriority="high"
          decoding="async"
        />
      </figure>
      <h2>Method</h2>
      <p class="measure">{item.method}</p>
      <h2>Procedure</h2>
      <ol class="steps">
        {
          linesOf(item.procedure).map((line, index) => (
            <li class="step">
              <span class="step-mark">{String(index + 1).padStart(2, '0')}</span>
              <p>{line}</p>
            </li>
          ))
        }
      </ol>
      {
        photos.length > 0 && (
          <>
            <h2>Photographs</h2>
            <ul class="photo-row">
              {photos.map((src) => (
                <li>
                  <img src={url(src)} alt="" loading="lazy" decoding="async" />
                </li>
              ))}
            </ul>
          </>
        )
      }
      {
        related.length > 0 && (
          <>
            <h2>Work in this category</h2>
            <ul class="work-grid">
              {related.map((project) => (
                <li>
                  <a href={url(`/projects/${project.slug}`)}>
                    <img
                      src={url(project.image)}
                      width={project.width}
                      height={project.height}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                    <span>
                      <small>{project.tags}</small>
                      {project.title}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
      <p class="action-row">
        <a class="visit" href={url(`/meet?topic=${encodeURIComponent(item.title)}`)}>Book a visit about this material</a>
        <a href={url('/materials')}>All materials</a>
      </p>
    </div>
  </article>
</Base>
