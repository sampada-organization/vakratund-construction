---
import Base from '../../layouts/Base.astro';
import Continue from '../../components/Continue.astro';
import MaterialPlates from '../../components/MaterialPlates.astro';
import { site } from '../../lib/content';

const description = `Materials ${site.name} places: bitumen, concrete, stone, epoxy, marking paint, and masonry. Each one carries a method and a procedure.`;
---

<Base title="Materials" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Materials</h1>
      <p class="intro">Bitumen. Concrete. Gabion stone. Epoxy. Thermoplastic paint. Masonry.</p>
      <p>Bitumen and concrete go into roads. Concrete also goes into foundations and mass pours. Epoxy goes onto floors. Gabion stone goes into walls. Thermoplastic paint marks parking lines. Brick and reinforced concrete go into buildings.</p>
      <p>Each page has a photograph, the method, and the steps.</p>
      <MaterialPlates />
      <Continue href="/plant" label="Plant" text="The machines that move these materials." />
    </div>
  </section>
</Base>
