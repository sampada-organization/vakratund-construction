---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { plants } from '../lib/content';
import { plantIcon } from '../lib/marks';

const description = 'Plant and tools on the Vakratund Construction register: mixers, rollers, excavators, tippers, and tractors.';
---

<Base title="Plant and tools" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Plant and tools</h1>
      <p class="intro">{plants.intro} Change a count from the desk, then rebuild the site. The previous public website called this page Tools.</p>
      <div class="counts">
        {
          plants.register.map((item) => (
            <article class="count">
              <Icon name={plantIcon(item.name)} />
              <b>{item.count}</b>
              <h2>{item.name}</h2>
              <p>{item.note}</p>
            </article>
          ))
        }
      </div>
      <h2 class="earlier">Also named on the previous website</h2>
      <p>These lines had no count in the profile. Treat them as names to confirm, not as extra machines on top of the register.</p>
      <div class="cards">
        {plants.earlier.map((item) => (
          <article>
            <Icon name={plantIcon(item.name)} />
            <h3>{item.name}</h3>
            <p>{item.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
