---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { plants } from '../lib/content';
import { plantIcon } from '../lib/marks';

const description = 'Plant and tools on the Vakratund Construction register: mixers, rollers, excavators, tippers, and tractors.';
---

<Base title="Plant and tools" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Plant and tools</h1>
      <p class="intro">{plants.intro}</p>
      <div class="counts">
        {
          plants.register.map((item) => (
            <article class="count">
              <Icon name={plantIcon(item.name)} />
              <b>{item.count}</b>
              <h2>{item.name}</h2>
              {item.note && <p>{item.note}</p>}
            </article>
          ))
        }
      </div>
      {
        plants.earlier.length > 0 && (
          <div class="cards">
            {plants.earlier.map((item) => (
              <article>
                <Icon name={plantIcon(item.name)} />
                <h3>{item.name}</h3>
                <p>{item.note}</p>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Base>
