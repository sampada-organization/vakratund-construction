---
import Base from '../layouts/Base.astro';
import Continue from '../components/Continue.astro';
import Sheen from '../components/Sheen.astro';
import Steps from '../components/Steps.astro';
import { site, url } from '../lib/content';

const description = 'How a Vakratund job runs: one contact, a measurement, a written budget, our own machines, and a report.';
---

<Base title="Process" description={description}>
  <section class="section">
    <div class="wrap">
      <div class="split">
        <div>
          <h1>How a job runs</h1>
          <p class="intro">One person on the job. A measurement. A written budget. Our own machines.</p>
          <p>“{site.safety}”</p>
        </div>
        <Sheen kind="kit" />
      </div>
      <Steps heading="h2" />
      <h2>What the firm set out to do</h2>
      <ol class="mission">
        {site.mission.map((line) => <li>{line}</li>)}
      </ol>
      <p>Bitumen, concrete, stone, epoxy, paint, and masonry follow this same order.</p>
      <p>One contact. A measurement. A written budget. Our own machines. A safe site. A report while the work is moving.</p>
      <p>
        After the measurement, <a href={url('/meet')}>book the visit</a>. Or <a href={url('/onboard')}>send the client’s name</a>.
      </p>
      <Continue href="/clients" label="Clients" text="The manufacturers in Chakan named in the company profile." />
    </div>
  </section>
</Base>
