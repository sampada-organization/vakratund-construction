---
import Base from '../layouts/Base.astro';
import Sheen from '../components/Sheen.astro';
import Steps from '../components/Steps.astro';
import { site, url } from '../lib/content';

const description = 'How a Vakratund job runs: one contact, a measurement, a prescribed budget, own plant, and a report.';
---

<Base title="Process" description={description}>
  <section class="section">
    <div class="wrap">
      <div class="split">
        <div>
          <h1>How a job runs</h1>
          <p class="intro">
            {site.promise} One contact, a written budget, and our own machines.
            “{site.safety}”
          </p>
        </div>
        <Sheen kind="kit" />
      </div>
      <Steps heading="h2" />
      <h2>What the firm set out to do</h2>
      <ol class="mission">
        {site.mission.map((line) => <li>{line}</li>)}
      </ol>
      <p>
        The procedure for a material — bitumen, concrete, stone, epoxy, paint, or masonry — follows this same order:
        one contact, a measure, a written budget, our own plant, a safe site, and a report while the work is moving.
      </p>
      <p>
        When the measure is done, <a href={url('/meet')}>book the visit</a> or <a href={url('/onboard')}>tell us who the client is</a>.
        The material records are on the <a href={url('/materials')}>materials</a> page.
      </p>
    </div>
  </section>
</Base>
