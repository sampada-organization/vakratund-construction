---
import Base from '../layouts/Base.astro';
import Steps from '../components/Steps.astro';
import { site, url } from '../lib/content';

const description = 'How a Vakratund job runs: one contact, a measurement, a prescribed budget, own plant, and a report.';
---

<Base title="Process" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>How a job runs</h1>
      <p class="intro">
        The previous site said the work should be strong, durable, safe, economical, and facilitating. The profile says
        the same thing in the language of a sole proprietor: one contact, a written budget, and the yard’s own machines.
        Safety is stated as a mantra, not as a certificate we can quote a number for: “{site.safety}”
      </p>
      <Steps heading="h2" />
      <p>When the measure is done, <a href={url('/meet')}>book the visit</a> or <a href={url('/onboard')}>put the client on the desk</a>.</p>
    </div>
  </section>
</Base>
