---
import Base from '../../layouts/Base.astro';
import WorkGrid from '../../components/WorkGrid.astro';

const description = 'Gabion walls, foundations, floors, roads, and concrete by Vakratund Construction, Chakan.';
---

<Base title="Work" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Work</h1>
      <p class="intro">
        Gabion walls, foundations, floors, roads, and concrete. Open a picture for the set, then book a visit if the next job is the same kind of work.
      </p>
      <WorkGrid />
    </div>
  </section>
</Base>
