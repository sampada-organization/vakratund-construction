---
import Base from '../../layouts/Base.astro';
import Continue from '../../components/Continue.astro';
import WorkGrid from '../../components/WorkGrid.astro';

const description = 'Gabion walls, foundations, floors, roads, and concrete by Vakratund Construction, Chakan.';
---

<Base title="Work" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Work</h1>
      <p class="intro">
        Gabion walls. Machine foundations. Special foundations. Epoxy floors. Bitumen roads. Concrete roads. Parking
        lines. Mass concrete.
      </p>
      <p>These photographs are of jobs done in 2021. The work goes beyond the frames shown here.</p>
      <p>Choose a kind of job. Open it for the photographs. The material page has the method and the steps.</p>
      <WorkGrid />
      <Continue href="/services" label="Services" text="Roads, foundations, floors, walls, yards, and buildings." />
    </div>
  </section>
</Base>
