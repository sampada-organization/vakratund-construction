---
import Base from '../../layouts/Base.astro';
import WorkGrid from '../../components/WorkGrid.astro';

const description = 'Gabion walls, foundations, floors, roads, and concrete by Vakratund Construction, Chakan.';
---

<Base title="Work" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Work</h1>
      <p class="intro">
        Gabion walls, machine foundations, special foundations, floor maintenance and epoxy, bitumen roads, concrete
        roads, parking lines, and mass concrete. The company profile dates these photographs to jobs executed in 2021,
        and notes that the work goes further than the frames shown here.
      </p>
      <p>
        Filter by the kind of job. Open a picture for the set, then the material page for the method and the procedure.
      </p>
      <WorkGrid />
    </div>
  </section>
</Base>
