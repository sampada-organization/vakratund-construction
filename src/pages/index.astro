---
import Base from '../layouts/Base.astro';
import HeroSlides from '../components/HeroSlides.astro';
import WorkGrid from '../components/WorkGrid.astro';
import MachineTiles from '../components/MachineTiles.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import Study from '../components/Study.astro';
import Continue from '../components/Continue.astro';
import { clients, materials, site, url } from '../lib/content';

const description =
  'Vakratund Construction, Chakan. Civil works, roads, RCC, and government contracts since 2007. One proprietor and an owned plant.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: site.name,
  url: new URL(import.meta.env.BASE_URL, Astro.site ?? 'https://vakrtundconstruction.com').href,
  telephone: site.phoneTel,
  email: site.email,
  foundingDate: String(site.established),
  founder: { '@type': 'Person', name: site.proprietor },
  image: new URL(url('/brand/mark.jpg'), Astro.site ?? 'https://vakrtundconstruction.com').href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Shop No. 113, 1st floor, The Grand Centre, Gat No. 1638',
    addressLocality: 'Chakan',
    postalCode: '410501',
    addressRegion: 'Maharashtra',
    addressCountry: 'IN',
  },
  areaServed: 'Chakan, Pune',
};
---

<Base title={site.name} description={description} jsonLd={jsonLd}>
  <section class="hero hero-ledger">
    <div class="wrap ledger-top">
      <div>
        <p class="kicker">Chakan · since {site.established}</p>
        <h1>{site.name}</h1>
        <p class="tagline">{site.tagline}</p>
        <p>{site.promise}</p>
        <p class="measure">{site.measure}</p>
      </div>
      <Study />
    </div>
    <div class="wrap strip">
      <HeroSlides />
    </div>
  </section>

  <section class="section" id="firm">
    <div class="wrap firm">
      <div>
        <p class="kicker">The firm</p>
        <h2>Civil work, with the plant that places it</h2>
        <p>
          {site.name} is a {site.legalForm.toLowerCase()}. {site.proprietor} is the proprietor. The firm was
          established in {site.established} and has taken government contracts since {site.governmentWorkSince}. The
          work is for homes, factories, and public bodies.
        </p>
      </div>
      <ul class="facts">
        <li><div><strong>{site.established}</strong><span>Established</span></div></li>
        <li><div><strong>{site.governmentWorkSince}</strong><span>Government contracts</span></div></li>
        <li><div><strong>Chakan</strong><span>The Grand Centre</span></div></li>
      </ul>
    </div>
  </section>

  <section class="section" id="work">
    <div class="wrap">
      <p class="kicker">Work</p>
      <h2>Jobs the profile records</h2>
      <p class="intro">
        Gabion walls, foundations, floors, roads, parking lines, and mass concrete. The profile dates these
        photographs to jobs executed in 2021.
      </p>
      <WorkGrid minimal ledger />
    </div>
  </section>

  <section class="section" id="services">
    <div class="wrap">
      <p class="kicker">Services</p>
      <h2>The trades</h2>
      <p class="intro">Roads, foundations, floors, walls, yards, and buildings. Each one places a material.</p>
      <ServiceCards ledger />
    </div>
  </section>

  <section class="section" id="materials">
    <div class="wrap">
      <p class="kicker">Materials</p>
      <h2>What the crew places</h2>
      <p class="intro">
        Bitumen, concrete, gabion stone, epoxy, thermoplastic paint, and masonry. A material page keeps the method
        and the procedure.
      </p>
      <ul class="index-list">
        {
          materials.map((item) => (
            <li>
              <a href={url(`/materials/${item.slug}`)}>
                <small>{item.category}</small>
                <strong>{item.title}</strong>
                <span>{item.summary}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="tools">
    <div class="wrap">
      <p class="kicker">Plant</p>
      <h2>Machines on the register</h2>
      <p class="intro">Owned plant. The counts are the company profile’s counts.</p>
      <MachineTiles linked showCount ledger />
      <Continue
        href="/plant"
        label="plant and tools"
        name="Further: Plant and tools"
        text="The counts and the machines are kept with the"
      />
    </div>
  </section>

  <section class="section defer" id="method">
    <div class="wrap firm">
      <div>
        <p class="kicker">Method</p>
        <h2>One contact, then the material</h2>
        <p>
          One person stays with the job. The line is measured before a price is promised. A written budget sits inside
          the time and the price agreed up front. The ready-mix plant, the mixers, the rollers, and the excavators are
          on our own register, and the method uses that plant.
        </p>
        <p>“{site.safety}”</p>
      </div>
      <ol class="mission">
        {site.mission.map((line) => <li>{line}</li>)}
      </ol>
    </div>
  </section>

  <section class="section defer">
    <div class="wrap">
      <p class="kicker">Clients</p>
      <h2>Plants in Chakan</h2>
      <p>Manufacturers named in the company profile. We build the civil work around their machines.</p>
      <p class="name-row">
        {clients.map((client) => <span>{client.name}</span>)}
      </p>
    </div>
  </section>

  <section class="section commission defer" id="catch">
    <div class="wrap">
      <h2><Icon name="sheet" />Start a job</h2>
      <p>
        Name, phone, and the kind of work. That is enough to start. Or call {site.phoneDisplay}, or use WhatsApp or email above.
      </p>
      <LeadForm kind="enquiry" compact />
    </div>
  </section>

  <section class="section close">
    <div class="wrap">
      <Continue href="/projects" label="work" name="Further: Work" text="The jobs already placed continue in the" />
    </div>
  </section>
</Base>
