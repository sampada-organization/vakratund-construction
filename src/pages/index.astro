---
import Base from '../layouts/Base.astro';
import Rise from '../components/Rise.astro';
import Steps from '../components/Steps.astro';
import Sheen from '../components/Sheen.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import ClientStrip from '../components/ClientStrip.astro';
import { links, plants, services, site, url } from '../lib/content';
import { plantIcon, serviceIcon } from '../lib/marks';

const description =
  'Vakratund Construction, Chakan. Civil works, roads, RCC, and government contracts since 2007. One proprietor and an owned plant.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: site.name,
  url: new URL(import.meta.env.BASE_URL, Astro.site ?? 'https://vakrtundconstruction.in').href,
  telephone: site.phoneTel,
  email: site.email,
  foundingDate: String(site.established),
  founder: { '@type': 'Person', name: site.proprietor },
  image: new URL(url('/brand/mark.jpg'), Astro.site ?? 'https://vakrtundconstruction.in').href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Shop No. 113, 1st floor, The Grand Centre, Gat No. 1638',
    addressLocality: 'Chakan',
    postalCode: '410501',
    addressRegion: 'Maharashtra',
    addressCountry: 'IN',
  },
  areaServed: 'Chakan, Pune',
};
---

<Base title={site.name} description={description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">Chakan · civil contractor · since {site.established}</p>
        <h1>{site.name}</h1>
        <p class="tagline">{site.tagline}</p>
        <p class="lede">{site.promise} Proprietor {site.proprietor}. One office, one answer.</p>
        <div class="hero-actions">
          <a class="visit" href={url('/meet')}><Icon name="calendar" />Book a site visit</a>
          <a class="ghost" href={url('/plant')}><Icon name="gear" />See the plant</a>
        </div>
        <p class="measure">{site.measure}</p>
      </div>
      <Rise />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>One office, since {site.established}</h2>
      <p>
        {site.name} is a {site.legalForm.toLowerCase()}. Proprietor {site.proprietor}. We carry out civil work
        for residential clients and industrial clients, and we have worked as government contractors since {site.governmentWorkSince}.
        The promise is plain: quality work, inside the given time, inside the agreed budget.
      </p>
      <ul class="facts">
        <li><div><Icon name="calendar" /><strong>{site.established}</strong><span>Established</span></div></li>
        <li><div><Icon name="column" /><strong>{site.governmentWorkSince}</strong><span>Government work begins</span></div></li>
        <li><div><Icon name="person" /><strong>1</strong><span>Proprietor, one point of contact</span></div></li>
      </ul>
      <h3>What we set out to do</h3>
      <ol class="mission">
        {site.mission.map((line) => <li>{line}</li>)}
      </ol>
      <p class="action-row">
        <a class="visit" href={url('/profile')}><Icon name="sheet" />Business profile</a>
        <a class="visit" href={links.tel}><Icon name="phone" />{site.phoneDisplay}</a>
        <a class="visit" href={links.email}><Icon name="mail" />Email the office</a>
      </p>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="split">
        <header>
          <h2>Services</h2>
          <p>Buildings, roads, concrete, masonry, government work, and plotting.</p>
        </header>
        <Sheen kind="yard" />
      </div>
      <div class="cards">
        {services.map((service) => (
          <article>
            <Icon name={serviceIcon(service.title)} />
            <h3>{service.title}</h3>
            <p>{service.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <header>
        <h2>How a job runs</h2>
        <p>From the first call to the last report. One person stays on the job.</p>
      </header>
      <Steps />
      <p><a href={url('/process')}>Read the process with the plant beside it</a></p>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <header>
        <h2>Work</h2>
        <p>Gabion walls, foundations, floors, roads, parking marks, and mass concrete. There is more work than these frames.</p>
      </header>
      <WorkGrid />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <header>
        <h2>Plant on the register</h2>
        <p>{plants.intro}</p>
      </header>
      <div class="counts">
        {plants.register.map((item) => (
          <article class="count">
            <Icon name={plantIcon(item.name)} />
            <b>{item.count}</b>
            <h3>{item.name}</h3>
          </article>
        ))}
      </div>
      <p><a href={url('/plant')}>See every machine and its count</a></p>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <header>
        <h2>Clients</h2>
        <p>Manufacturers with plants in Chakan. We build the civil work around their machines.</p>
      </header>
      <ClientStrip />
    </div>
  </section>

  <section class="section commission" id="catch">
    <div class="wrap">
      <h2><Icon name="sheet" />Start a job</h2>
      <p>
        Name, phone, and the kind of work. That is enough to start. Or call {site.phoneDisplay}, or use WhatsApp or email above.
      </p>
      <LeadForm kind="enquiry" compact />
    </div>
  </section>
</Base>
