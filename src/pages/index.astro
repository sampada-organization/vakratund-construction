---
import Base from '../layouts/Base.astro';
import HeroSlides from '../components/HeroSlides.astro';
import WorkGrid from '../components/WorkGrid.astro';
import MachineTiles from '../components/MachineTiles.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import ClientStrip from '../components/ClientStrip.astro';
import { site, url } from '../lib/content';

const description =
  'Vakratund Construction, Chakan. Civil works, roads, RCC, and government contracts since 2007. One proprietor and an owned plant.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: site.name,
  url: new URL(import.meta.env.BASE_URL, Astro.site ?? 'https://vakrtundconstruction.com').href,
  telephone: site.phoneTel,
  email: site.email,
  foundingDate: String(site.established),
  founder: { '@type': 'Person', name: site.proprietor },
  image: new URL(url('/brand/mark.jpg'), Astro.site ?? 'https://vakrtundconstruction.com').href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Shop No. 113, 1st floor, The Grand Centre, Gat No. 1638',
    addressLocality: 'Chakan',
    postalCode: '410501',
    addressRegion: 'Maharashtra',
    addressCountry: 'IN',
  },
  areaServed: 'Chakan, Pune',
};
---

<Base title={site.name} description={description} jsonLd={jsonLd}>
  <section class="hero hero-reel">
    <div class="wrap">
      <p class="kicker">Chakan · since {site.established}</p>
      <h1>{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
      <HeroSlides />
    </div>
  </section>

  <section class="section alt" id="work">
    <div class="wrap">
      <header class="row-head">
        <h2>Work</h2>
        <a href={url('/projects')} aria-label="Further: Work">Further</a>
      </header>
      <WorkGrid minimal />
    </div>
  </section>

  <section class="section" id="tools">
    <div class="wrap">
      <header class="row-head">
        <h2>Tools</h2>
        <a href={url('/plant')} aria-label="Further: Plant and tools">Further</a>
      </header>
      <MachineTiles linked showCount />
    </div>
  </section>

  <section class="section" id="services">
    <div class="wrap">
      <header class="row-head">
        <h2>Services</h2>
        <a href={url('/services')} aria-label="Further: Services">Further</a>
      </header>
      <ServiceCards />
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <header>
        <h2>Clients</h2>
        <p>Manufacturers with plants in Chakan. We build the civil work around their machines.</p>
      </header>
      <ClientStrip />
    </div>
  </section>

  <section class="section commission" id="catch">
    <div class="wrap">
      <h2><Icon name="sheet" />Start a job</h2>
      <p>
        Name, phone, and the kind of work. That is enough to start. Or call {site.phoneDisplay}, or use WhatsApp or email above.
      </p>
      <LeadForm kind="enquiry" compact />
    </div>
  </section>
</Base>
