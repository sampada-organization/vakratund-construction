---
import Base from '../layouts/Base.astro';
import HeroSlides from '../components/HeroSlides.astro';
import HomeWork from '../components/HomeWork.astro';
import MachineTiles from '../components/MachineTiles.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import Ask from '../components/Ask.astro';
import Continue from '../components/Continue.astro';
import StatsBar from '../components/StatsBar.astro';
import ClientsBand from '../components/ClientsBand.astro';
import { home, site, url } from '../lib/content';

const siteUrl = site.domain.startsWith('http') ? site.domain : `https://${site.domain}`;
const description =
  'Vakratund Construction, Chakan. Civil works, roads, RCC, and government contracts since 2007. One proprietor and an owned plant.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: site.name,
  url: new URL(import.meta.env.BASE_URL, Astro.site ?? siteUrl).href,
  telephone: site.phoneTel,
  email: site.email,
  foundingDate: String(site.established),
  founder: { '@type': 'Person', name: site.proprietor },
  image: new URL(url('/brand/mark.jpg'), Astro.site ?? siteUrl).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Shop No. 113, 1st floor, The Grand Centre, Gat No. 1638',
    addressLocality: 'Chakan',
    postalCode: '410501',
    addressRegion: 'Maharashtra',
    addressCountry: 'IN',
  },
  areaServed: 'Chakan, Pune',
};
---

<Base title={site.name} description={description} jsonLd={jsonLd}>
  <HeroSlides
    kicker={`Chakan · since ${site.established}`}
    title={site.name}
    tagline={site.tagline}
    lead={home.lead}
    measure={site.measure}
  />

  <StatsBar />

  <section class="section" id="firm">
    <div class="wrap firm">
      <div>
        <p class="kicker">The firm</p>
        <h2>Who we are</h2>
        <p>{site.name} is a {site.legalForm.toLowerCase()}.</p>
        <p>{site.proprietor} is the proprietor and stays close to each job.</p>
        <p>We work for manufacturing plants, housing, and public departments around Chakan.</p>
      </div>
      <ul class="facts">
        <li><div><strong>{site.established}</strong><span>Established</span></div></li>
        <li><div><strong>{site.governmentWorkSince}</strong><span>Government contracts</span></div></li>
        <li><div><strong>Chakan</strong><span>The Grand Centre</span></div></li>
      </ul>
    </div>
  </section>

  <section class="section" id="work">
    <div class="wrap">
      <p class="kicker">Work</p>
      <h2>Work done</h2>
      <p class="intro">
        Browse by category — the 2021 portfolio, recent bridge jobs, an RMC plant for JD Infra, and civil work at SANY.
      </p>
      <HomeWork />
      <Ask />
      <Continue href="/projects" label="Work" name="Further: All work" text="Every project type with photographs and materials." />
    </div>
  </section>

  <ClientsBand />

  <section class="section" id="services">
    <div class="wrap">
      <p class="kicker">Services</p>
      <h2>What we take on</h2>
      <p class="intro">Roads, foundations, floors, walls, yards, and buildings — scoped and priced before we mobilise.</p>
      <ServiceCards ledger />
      <Continue href="/materials" label="Materials" name="Further: Materials and methods" text="Bitumen, concrete, gabion, epoxy, paint, and masonry — with steps." />
    </div>
  </section>

  <section class="section defer" id="tools">
    <div class="wrap">
      <p class="kicker">Plant</p>
      <h2>Our machines</h2>
      <p class="intro">Owned equipment from the company profile — not hired day to day.</p>
      <MachineTiles linked showCount ledger />
      <Continue
        href="/plant"
        label="Plant"
        name="Further: Plant and tools"
        text="Every machine, and how many."
      />
    </div>
  </section>

  <section class="section defer" id="method">
    <div class="wrap firm">
      <div>
        <p class="kicker">Method</p>
        <h2>How a job starts</h2>
        <p>One person stays with the job from estimate to handover.</p>
        <p>We measure the line before we quote.</p>
        <p>Time and price are agreed in writing.</p>
        <p>The ready-mix plant, mixers, rollers, and excavators are ours.</p>
        <p>“{site.safety}”</p>
      </div>
      <ol class="mission">
        {site.mission.map((line) => <li>{line}</li>)}
      </ol>
    </div>
  </section>

  <section class="section commission defer" id="catch">
    <div class="wrap">
      <h2><Icon name="sheet" />Start a job</h2>
      <p>Send your name, phone number, and the kind of work. Or call {site.phoneDisplay}.</p>
      <LeadForm kind="enquiry" compact />
    </div>
  </section>
</Base>
