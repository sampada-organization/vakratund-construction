---
import Base from '../layouts/Base.astro';
import HeroSlides from '../components/HeroSlides.astro';
import WorkGrid from '../components/WorkGrid.astro';
import MachineTiles from '../components/MachineTiles.astro';
import Beam from '../components/Beam.astro';
import ClientStrip from '../components/ClientStrip.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import Ask from '../components/Ask.astro';
import Continue from '../components/Continue.astro';
import { home, links, site, url } from '../lib/content';

const siteUrl = site.domain.startsWith('http') ? site.domain : `https://${site.domain}`;
const description =
  'Vakratund Construction, Chakan. Roads, RCC, buildings, and government contracts since 2007. One proprietor and an owned plant.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: site.name,
  url: new URL(import.meta.env.BASE_URL, Astro.site ?? siteUrl).href,
  telephone: site.phoneTel,
  email: site.email,
  foundingDate: String(site.established),
  founder: { '@type': 'Person', name: site.proprietor },
  image: new URL(url('/brand/mark.jpg'), Astro.site ?? siteUrl).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Shop No. 113, 1st floor, The Grand Centre, Gat No. 1638',
    addressLocality: 'Chakan',
    postalCode: '410501',
    addressRegion: 'Maharashtra',
    addressCountry: 'IN',
  },
  areaServed: 'Chakan, Pune',
};
---

<Base title={site.name} description={description} jsonLd={jsonLd}>
  <HeroSlides
    kicker={`Chakan · since ${site.established}`}
    title={site.name}
    tagline={site.tagline}
    lead={home.lead}
    measure={site.measure}
  />

  <section class="section" id="firm">
    <div class="wrap firm">
      <div>
        <p class="kicker">The firm</p>
        <h2>Who we are</h2>
        <p>{site.name} is a {site.legalForm.toLowerCase()}.</p>
        <p><a href={links.linkedin}>{site.proprietor}</a> is the proprietor and stays close to each job.</p>
        <p>The office is Shop 113, The Grand Centre, Chakan.</p>
      </div>
      <ul class="facts">
        <li><div><strong>{site.established}</strong><span>Established</span></div></li>
        <li><div><strong>{site.governmentWorkSince}</strong><span>Government contracts</span></div></li>
        <li><div><strong>Chakan</strong><span>The Grand Centre</span></div></li>
      </ul>
    </div>
  </section>

  <section class="section" id="work">
    <div class="wrap">
      <p class="kicker">Work</p>
      <h2>Types of work</h2>
      <p class="intro">
        Eight kinds from the 2021 portfolio. Bridge photographs and the JD Infra ready-mix yard were taken later. The film above is the pooja at SANY, Chakan.
      </p>
      <WorkGrid minimal large />
      <Ask />
      <Continue href="/projects" label="Work" name="Further: All work" text="Every type, with the photographs and the materials." />
    </div>
  </section>

  <section class="section" id="bend">
    <div class="wrap">
      <p class="kicker">Mechanics</p>
      <h2>Why the steel sits low</h2>
      <Beam />
    </div>
  </section>

  <section class="section" id="clients">
    <div class="wrap">
      <p class="kicker">Clients</p>
      <h2>Plants in Chakan</h2>
      <p class="intro">Five names from the company profile.</p>
      <ClientStrip />
      <Continue href="/clients" label="Clients" name="Further: Clients" text="The same names, on their own page." />
    </div>
  </section>

  <section class="section defer" id="tools">
    <div class="wrap">
      <p class="kicker">Plant</p>
      <h2>Machines</h2>
      <p class="intro">The kinds of machine we own.</p>
      <MachineTiles linked roomy />
      <Continue href="/plant" label="Plant" name="Further: Plant and tools" text="Each kind of machine, and what it does." />
    </div>
  </section>

  <section class="section defer" id="method">
    <div class="wrap firm">
      <div>
        <p class="kicker">Method</p>
        <h2>How a job starts</h2>
        <p>One person stays with the job from estimate to handover.</p>
        <p>We measure the line before we quote.</p>
        <p>Time and price are agreed in writing.</p>
        <p>“{site.safety}”</p>
      </div>
      <ol class="mission">
        {site.mission.map((line) => <li>{line}</li>)}
      </ol>
    </div>
  </section>

  <section class="section commission defer" id="catch">
    <div class="wrap">
      <h2><Icon name="sheet" />Start a job</h2>
      <p>Send your name, phone number, and the kind of work. Or call {site.phoneDisplay}.</p>
      <LeadForm kind="enquiry" compact />
    </div>
  </section>
</Base>
