---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../lib/content';

const description = 'Book a Vakratund site visit and raise it by browser notification, WhatsApp, or email.';
---

<Base title="Book a visit" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Book a site visit</h1>
      <p class="intro">
        Choose a time. We keep the request, then you can send it on WhatsApp or email, or save it in your calendar.
      </p>
      <ul>
        <li><strong>Browser.</strong> This tab can show a notification now. A reminder fires only if the visit is inside two hours and the tab stays open.</li>
        <li><strong>WhatsApp.</strong> Opens a message to {site.phoneDisplay} with the visit written out. You press send.</li>
        <li><strong>Email.</strong> Opens a letter to {site.email}. You press send.</li>
      </ul>
      <p>A calendar file is offered as well. That reminder lives on the phone, not in this tab.</p>
      <LeadForm kind="meeting" />
    </div>
  </section>
</Base>
