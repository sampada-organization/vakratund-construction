---
import Base from '../layouts/Base.astro';
import Continue from '../components/Continue.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../lib/content';

const description = 'Book a Vakratund site visit and raise it by browser notification, WhatsApp, or email.';
---

<Base title="Book a visit" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Book a site visit</h1>
      <p class="intro">
        Leave your name, phone, and a time. We measure the site before we give a price. Or call {site.phoneDisplay}.
      </p>
      <LeadForm kind="meeting" />
      <p>
        After you book, this page offers WhatsApp to {site.phoneDisplay}, an email to {site.email}, and a calendar file.
        You press send. A reminder in this tab fires only if the visit is inside two hours and the tab stays open.
      </p>
      <Continue href="/contact" label="Contact" text="The office address and the phone." />
    </div>
  </section>
</Base>
