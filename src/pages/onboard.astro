---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';

const description = 'Put a client on the Vakratund desk: firm, person, phone, site, and the work.';
---

<Base title="Client identity" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Client identity</h1>
      <p class="intro">
        A client comes on board with a firm or a house name, a person, a phone, a site, and the work. This is the record
        the office keeps. It is not a password, and it does not open a private portal. On this computer the note is stored
        for the desk. On the live free host it is filed as a private GitHub issue, the same pattern as the other office forms.
      </p>
      <LeadForm kind="onboard" />
    </div>
  </section>
</Base>
