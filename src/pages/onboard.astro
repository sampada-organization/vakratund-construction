---
import Base from '../layouts/Base.astro';
import Continue from '../components/Continue.astro';
import LeadForm from '../components/LeadForm.astro';

const description = 'Tell Vakratund Construction who you are, where the site is, and the work.';
---

<Base title="Client identity" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Client identity</h1>
      <p class="intro">
        A firm or a house name, a person, a phone, a site, and the work. The office keeps that and calls you back.
        This is not a password and it does not open a private page.
      </p>
      <LeadForm kind="onboard" />
      <Continue href="/contact" label="contact" text="The office that keeps this note is on" />
    </div>
  </section>
</Base>
