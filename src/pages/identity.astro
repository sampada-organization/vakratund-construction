---
import Base from '../layouts/Base.astro';
import Continue from '../components/Continue.astro';
import Icon from '../components/Icon.astro';
import { links, site, url } from '../lib/content';

const description = 'Name, mark, colours, and contact channels for Vakratund Construction.';
---

<Base title="Digital identity" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Digital identity</h1>
      <p class="intro">
        {site.name}. Proprietor {site.proprietor}. The mark is the supplied blue VC, with the gray plate lifted so the
        letters sit on the page. The office is in Chakan. The domain is {site.domain}.
      </p>
      <figure class="figure">
        <img src={url('/brand/mark.png')} width="300" height="202" alt="VC mark, blue lettering with a skyline cut into the C" />
        <figcaption>The supplied mark. The gray plate is removed. The letters, and the skyline cut into the C, are unchanged.</figcaption>
      </figure>
      <h2>Colour roles</h2>
      <p>
        Charcoal ground, a chrome edge, and the blue metal of the mark. The blue is a short gradient, light at the
        highlight and deep in the letter. Actions are lines of type, with that blue as the rule.
      </p>
      <div class="swatches">
        <div class="swatch" style="background:#10141c;color:#fff"><span>Charcoal</span>#10141c</div>
        <div class="swatch" style="background:linear-gradient(120deg,#d5dde8,#3d7dff 55%,#12306e);color:#fff"><span>Mark gradient</span></div>
        <div class="swatch" style="background:#1d4ed8;color:#fff"><span>Mark blue</span>#1d4ed8</div>
        <div class="swatch" style="background:#12306e;color:#fff"><span>Deep blue</span>#12306e</div>
        <div class="swatch" style="background:#d5dde8;color:#17191e"><span>Chrome</span>#d5dde8</div>
        <div class="swatch" style="background:#eef2f7;color:#17191e"><span>Type</span>#eef2f7</div>
      </div>
      <h2>How to reach the office</h2>
      <ul>
        <li><a class="btn-call" href={links.tel}><Icon name="phone" />Call {site.phoneDisplay}</a></li>
        <li><a class="btn-wa" href={links.whatsapp}><Icon name="chat" />WhatsApp</a></li>
        <li><a class="btn-gmail" href={links.email}><Icon name="mail" />Gmail</a></li>
        <li><a href={links.proprietorEmail}>{site.proprietorEmail}</a> — {site.proprietor}</li>
      </ul>
      <p>There is no login for clients. A client identity is a name, a phone, a site, and the work, filed from the on-board page.</p>
      <Continue href="/profile" label="profile" text="The person and the offices are written in the" />
    </div>
  </section>
</Base>
