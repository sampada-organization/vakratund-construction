---
import Base from '../layouts/Base.astro';
import { links, site, url } from '../lib/content';

const description = 'Name, mark, colours, and contact channels for Vakratund Construction.';
---

<Base title="Digital identity" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Digital identity</h1>
      <p class="intro">
        {site.name}. Proprietor {site.proprietor}. The mark is the blue VC. The office is in Chakan.
      </p>
      <figure class="figure">
        <img src={url('/brand/mark.jpg')} width="319" height="262" alt="Supplied VC mark, blue lettering with a skyline cut into the C" />
        <figcaption>The mark used on this site.</figcaption>
      </figure>
      <h2>Colour roles</h2>
      <p>Charcoal and silver from the mark. Blue for an action. Gold for a measurement, the same gold as the roads poster.</p>
      <div class="swatches">
        <div class="swatch" style="background:#12151c;color:#fff"><span>Charcoal</span>#12151c</div>
        <div class="swatch" style="background:#1a46c8;color:#fff"><span>Mark blue</span>#1a46c8</div>
        <div class="swatch" style="background:#e0a82e;color:#17191e"><span>Road gold</span>#e0a82e</div>
        <div class="swatch" style="background:#c9d0d8;color:#17191e"><span>Silver</span>#c9d0d8</div>
        <div class="swatch" style="background:#f4f2ec;color:#17191e"><span>Paper</span>#f4f2ec</div>
        <div class="swatch" style="background:#0e1c4a;color:#fff"><span>Deep blue</span>#0e1c4a</div>
      </div>
      <h2>How to reach the office</h2>
      <ul>
        <li><a href={links.tel}>Call {site.phoneDisplay}</a></li>
        <li><a href={links.whatsapp}>WhatsApp</a> — opens a message to the office</li>
        <li><a href={links.email}>{site.email}</a></li>
        <li><a href={links.proprietorEmail}>{site.proprietorEmail}</a> — {site.proprietor}</li>
      </ul>
      <p>There is no login for clients. A client identity is a name, a phone, a site, and the work, filed from the on-board page.</p>
    </div>
  </section>
</Base>
