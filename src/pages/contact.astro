---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import { links, site, url } from '../lib/content';

const description = `Office of Vakratund Construction at The Grand Centre, Chakan. Call ${site.phoneDisplay}.`;
---

<Base title="Contact" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>The office</h1>
      <p class="intro">{site.office.lines.join(', ')}. {site.hours}.</p>
      <p class="action-row">
        <a class="btn-call" href={links.tel}><Icon name="phone" />{site.phoneDisplay}</a>
        <a class="btn-wa" href={links.whatsapp}><Icon name="chat" />WhatsApp</a>
        <a class="btn-gmail" href={links.email}><Icon name="mail" />Gmail</a>
        <a class="visit" href={links.maps}><Icon name="pin" />Map</a>
        <a class="visit" href={url('/profile')}><Icon name="sheet" />Business profile</a>
      </p>
      <p>{site.proprietor}: <a href={links.proprietorEmail}>{site.proprietorEmail}</a></p>
      
      <h2>Write</h2>
      <LeadForm kind="enquiry" />
    </div>
  </section>
</Base>
