---
import Ask from '../../components/Ask.astro';
import Base from '../../layouts/Base.astro';
import Continue from '../../components/Continue.astro';
import ServiceCards from '../../components/ServiceCards.astro';

const description = 'Roads, foundations, floors, walls, yards, and buildings by Vakratund Construction, Chakan.';
---

<Base title="Services" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Services</h1>
      <p class="intro">
        Building construction. Roads. RCC and concrete. Brick and masonry. Plotting. Government and infrastructure jobs use these same trades.
      </p>
      <p>Each page names the material, the method, and the steps.</p>
      <ServiceCards />
      <Ask />
      <Continue href="/materials" label="Materials" text="Bitumen, concrete, stone, epoxy, paint, and masonry. Each one has a method and the steps." />
    </div>
  </section>
</Base>
