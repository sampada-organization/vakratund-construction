---
import Base from '../../layouts/Base.astro';
import Continue from '../../components/Continue.astro';
import ServiceCards from '../../components/ServiceCards.astro';

const description = 'Roads, foundations, floors, walls, yards, and buildings by Vakratund Construction, Chakan.';
---

<Base title="Services" description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Services</h1>
      <p class="intro">
        Building construction, road construction, civil works, RCC and concrete, brick and masonry, government and
        infrastructure work, and plotting. The trades follow the job. The material each one places is listed with its
        method.
      </p>
      <ServiceCards />
      <Continue href="/materials" label="materials" text="What each trade places, and the procedure for it, is kept with the" />
    </div>
  </section>
</Base>
